{
  "mode": "enforce",
  "migrations": false,
  "maxAgeDays": 14,
  "rules": [
    {"id": "contact-address", "kind": "mirror", "source": ["index.html"], "extract": "href=\"mailto:([^\"]+)\"", "docs": ["README.md", "docs/USER-GUIDE.md", "docs/ARCHITECTURE.md"], "why": "the site's contact address is the one the docs give", "added": "2026-10-22"},
    {"id": "accent-color", "kind": "mirror", "source": ["assets/site.css"], "extract": "--accent: (#[0-9a-f]{6});", "docs": ["docs/IMPLEMENTATION.md", "docs/README.md"], "why": "the accent changed from volt to neon blue on 2026-10-21; docs must name the current one", "added": "2026-10-22"},
    {"id": "cache-stamp", "kind": "mirror", "source": ["scripts/build_work.py"], "extract": "^V = \"(\\d+)\"", "docs": ["docs/OPERATIONS.md"], "why": "OPERATIONS names the current ?v= stamp, which must match index.html and the generator", "added": "2026-10-22"},
    {"id": "case-slugs", "kind": "mirror", "source": ["scripts/build_work.py"], "extract": "slug=\"([a-z0-9-]+)\"", "docs": ["docs/IMPLEMENTATION.md"], "why": "every generated case page is listed in IMPLEMENTATION", "added": "2026-10-22"},
    {"id": "clips", "kind": "mirror", "source": ["index.html"], "extract": "data-src=\"/?assets/clips/([a-z-]+)\\.mp4\"", "docs": ["docs/IMPLEMENTATION.md"], "why": "every hover clip is documented with its cut", "added": "2026-10-22"},
    {"id": "old-accent", "kind": "forbid", "pattern": "volt accent|#d7ff3a", "docs": ["README.md", "AGENTS.md", "docs/IMPLEMENTATION.md", "docs/ARCHITECTURE.md", "docs/USER-GUIDE.md", "docs/OPERATIONS.md"], "why": "the volt yellow accent was replaced by neon blue (2026-10-21)", "added": "2026-10-22"},
    {"id": "push-as-shanerealm", "kind": "require", "docs": ["docs/OPERATIONS.md"], "pattern": "gh auth token --user ShaneRealm", "why": "pushing as the active Acific account fails with 403", "added": "2026-10-22"}
  ]
}
